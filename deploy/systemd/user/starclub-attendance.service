[Unit]
Description=StarClub attendance platform
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/starclub/StarClub/sites/attendance
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/starclub/StarClub/sites/attendance/app.py
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
